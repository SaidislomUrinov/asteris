# Faqat admin, client, server papkalari yuklanadi — boshqa hamma narsa e'tiborsiz qoldiriladi
/*
!/admin
!/client
!/server
!/.gitignore

# node_modules (har qanday chuqurlikda)
node_modules/

# Environment fayllar
.env
.env.*
!.env.example

# Build/output
dist/
build/
.vite/

# Log fayllar
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor
.DS_Store
.vscode/
.idea/
