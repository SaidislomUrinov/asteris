# Faqat admin, client, server papkalari yuklanadi — boshqa hamma narsa e'tiborsiz qoldiriladi
/*
!/admin
!/client
!/server
!/parent
!/.gitignore

# node_modules (har qanday chuqurlikda)
node_modules/

# Environment fayllar
.env
.env.*
!.env.example

# Runtime ma'lumot — DB dumplari (shaxsiy ma'lumot!) va foydalanuvchi
# yuklagan fayllar repoga tushmaydi; ular serverda alohida backup qilinadi.
server/backups/
server/uploads/

# Build/output
dist/
build/
.vite/

# Log fayllar
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS/editor
.DS_Store
.vscode/
.idea/
