# WENET admin (console.wenet.uz) — React Router SPA uchun fallback
# Barcha noma'lum yo'llar index.html'ga yo'naltiriladi, statik fayllar (JS/CSS/rasm) esa
# to'g'ridan-to'g'ri xizmat qilinadi.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Haqiqiy fayl yoki papka bo'lsa — o'zidan xizmat qilinsin
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qolgan hamma narsa SPA entry point'ga
  RewriteRule ^ index.html [L]
</IfModule>

# Statik assetlarni uzoq muddat keshlash (Vite build fayllari hash'langan nomda)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# index.html hech qachon keshlanmasin — yangi deploy darhol ko'rinsin
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Gzip siqish
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
